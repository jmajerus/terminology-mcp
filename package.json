{
  "name": "terminology-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local taxonomy store and editor",
  "license": "PolyForm-Noncommercial-1.0.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node --import tsx src/main.ts",
    "demo": "node --import tsx src/main.ts --demo",
    "build": "tsc",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json && tsc -p tsconfig.experiments.json && node --check public/app.js && node --check public/sets.js && node --check public/graph.js && node --check public/graph-export.js",
    "test": "node --import tsx --test test/*.test.ts test/*.test.mjs",
    "test:deploy": "python3 -m unittest discover -s test -p '*_test.py'",
    "deploy": "python3 tools/deploy.py",
    "status": "node tools/terminology-status.mjs",
    "scheme:delete": "node dist/cli.js delete",
    "scheme:rename": "node dist/cli.js rename",
    "test:ui": "playwright test",
    "test:oxigraph": "node --import tsx experiments/oxigraph/run.ts",
    "test:oxigraph-import": "node --import tsx experiments/oxigraph/import.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "better-sqlite3": "^13.0.3",
    "d3-force": "^3.0.0",
    "jose": "^6.2.14",
    "n3": "^2.13.12",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/n3": "^1.26.6",
    "@types/node": "^22.19.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
