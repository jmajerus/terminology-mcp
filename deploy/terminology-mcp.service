[Unit]
Description=Terminology taxonomy editor
After=network.target

[Service]
Type=simple
User=terminology-mcp
Group=terminology-mcp
WorkingDirectory=/opt/terminology-mcp/current
ExecStart=/opt/terminology-mcp/runtime/bin/node /opt/terminology-mcp/current/dist/main.js
Environment=NODE_ENV=production
Environment=PORT=8000
Environment=HOST=0.0.0.0
Environment=TERMINOLOGY_DB=/var/lib/terminology-mcp/terminology.sqlite
EnvironmentFile=/etc/terminology-mcp/environment
StateDirectory=terminology-mcp
StateDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
